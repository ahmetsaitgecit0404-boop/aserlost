<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.muvekkilbilgi.dogrulayici"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Uygulama internete cikmiyor: kod tamamen cihazda, saat ve gizli
         anahtar kullanilarak uretiliyor. Bu yuzden hicbir izin istemiyor. -->

    <application
        android:label="Muvekkil Bilgi Dogrulayici"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
